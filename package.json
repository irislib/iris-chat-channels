{
  "name": "@irislib/openclaw-iris-chat",
  "version": "0.1.0",
  "description": "Iris Chat as a native OpenClaw channel",
  "type": "module",
  "license": "MIT",
  "files": [
    "openclaw/*.mjs",
    "hermes/transport.py",
    "openclaw.plugin.json",
    "secret-contract-api.mjs",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": "2026.10.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./openclaw/index.mjs"
    ],
    "setupEntry": "./openclaw/setup-entry.mjs",
    "channel": {
      "id": "iris",
      "label": "Iris Chat",
      "blurb": "Private chat with your agent over Iris."
    },
    "compat": {
      "minGatewayVersion": "2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9",
      "pluginSdkVersion": "2026.10.9"
    }
  }
}
