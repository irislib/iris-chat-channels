{
  "name": "@irislib/openclaw-iris-chat",
  "version": "0.2.1",
  "description": "Iris Chat channel: Signal-like messaging with Nostr Double Ratchet encryption, without phone numbers or signup.",
  "type": "module",
  "license": "MIT",
  "files": [
    "openclaw/*.mjs",
    "hermes/transport.py",
    "openclaw.plugin.json",
    "secret-contract-api.mjs",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": "2026.10.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./openclaw/index.mjs"
    ],
    "setupEntry": "./openclaw/setup-entry.mjs",
    "channel": {
      "id": "iris",
      "label": "Iris Chat",
      "blurb": "Signal-like messaging with Nostr Double Ratchet encryption; no phone number or signup."
    },
    "compat": {
      "pluginApi": "2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9",
      "pluginSdkVersion": "2026.10.9"
    },
    "install": {
      "clawhubSpec": "clawhub:@irislib/openclaw-iris-chat",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.10.9"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/irislib/iris-chat-channels.git"
  },
  "homepage": "https://irischat.org",
  "keywords": [
    "iris",
    "nostr",
    "messaging",
    "encrypted-chat",
    "openclaw-plugin"
  ]
}
